{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beyond10x.github.io/service-sdk/contracts/service-catalog.schema.json",
  "title": "service-catalog/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "service_ref",
    "display_name",
    "description",
    "semantic_catalog",
    "authentication",
    "operations"
  ],
  "properties": {
    "format": { "const": "service-catalog/1" },
    "service_ref": { "type": "string", "pattern": "^service:[a-z0-9_-]+$" },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "semantic_catalog": {
      "type": "object",
      "required": ["format"],
      "properties": { "format": { "const": "ess-browser-catalog/1" } }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "realm_policy"],
      "properties": {
        "source": { "const": "session" },
        "realm_policy": { "enum": ["required", "optional", "forbidden"] }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "operation_ref",
          "semantic_ref",
          "kind",
          "effect",
          "input_schema",
          "output_schema"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "operation_ref": { "type": "string", "minLength": 1 },
          "semantic_ref": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["intent", "query"] },
          "effect": { "enum": ["read", "write"] },
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" }
        }
      }
    }
  }
}
