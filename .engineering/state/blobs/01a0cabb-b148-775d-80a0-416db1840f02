ng-denying Clippy, workspace tests and doc tests, warning-denying Rustdoc, AEP validation, release-action checks, and the pinned pnpm 10.15.0 console typecheck plus four browser unit tests. git diff --check also passed. The candidate is ready for the coordinating agent's bot publication; downstream consumers will use that exact published SDK commit.\n","relations":[{"derived_from":"story:align-current-connectors-service-identity"},{"serves":"vision:composable-services"}],"status":"implemented","summary":"Use one exact Connector factory identity for the faster Smart Git runtime and generated consumers.","title":"Align generated services with Connectors 0.6.4"},"lifecycle_state":"implemented"}},"id":"MIGc477f4ee91656b9513ee052a4e88451c0e0f7daef613619cff8a4c4fd270f5af","lifecycle_state":"recorded","revision":5,"version":1},"order":"per_kind_only","subject":["aep.entity","MIGc477f4ee91656b9513ee052a4e88451c0e0f7daef613619cff8a4c4fd270f5af"]}]